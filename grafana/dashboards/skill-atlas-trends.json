    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-request token cost over time",
      "datasource": {
        "type": "postgres",
        "uid": "skill-atlas-pg"
      },
      "description": "The agent listing line begins at the run the fourth root was added -- before that it is null, which is the moment the second billed listing appeared.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skill-atlas-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, (metrics->>'listing_tok')::float AS \"Skill listing\", (metrics->>'agent_listing_tok')::float AS \"Agent listing\", (metrics->>'listing_budget_tok')::float AS \"Listing budget\" FROM atlas.runs ORDER BY ts",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
