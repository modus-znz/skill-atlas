        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skill-atlas-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (metrics->>'total')::float AS v FROM atlas.runs ORDER BY ts DESC LIMIT 1",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^v$/"
